import pytest

from src.packages.data.model.dish import Dish
from src.packages.service.dishes_service import DishesService

__dish = Dish("carbonara", "pasta")

@pytest.fixture
def dishes_service():
    return DishesService()

def test_to_check_repo(dishes_service, mocker):
    mocked_repo_find = mocker.patch.object(dishes_service._repository, "find")
    dishes_service.add(__dish)
    mocked_repo_find.assert_called_once_with(__dish.id)
